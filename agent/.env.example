# Alove bus-ticket agent worker for nhà xe Mai Anh — copy to agent/.env and fill in.
# NEVER commit the filled .env. Secrets belong in the host secret manager.

# --- LiveKit (same project as the web app) --------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name — MUST equal LIVEKIT_AGENT_NAME on the web side (default "alove").
# For LOCAL dev the worker auto-suffixes "-dev"; set the web side to "alove-dev"
# for that session so a local worker cannot steal production dispatches.
LIVEKIT_AGENT_NAME=alove

# --- Seam back to the Next.js booking and audit APIs -----------------------------
# Where the web app lives. The agent calls /api/booking/{search,hold,confirm,
# lookup,cancel} and posts call/transcript/booking audit events to /api/call/events.
NEXTJS_API_URL=http://localhost:3000
# Shared secret guarding every agent-only booking and call-events route (minimum 32 bytes).
# Generate: openssl rand -hex 32
# Set the SAME value as AGENT_WEBHOOK_SECRET in the web app's env.
AGENT_WEBHOOK_SECRET=

# --- Engine selection (A/B testable) --------------------------------------------
# AGENT_ENGINE: cascade (STT->LLM->TTS) | gemini-sts (Gemini Live speech-to-speech)
# STT_PROVIDER (cascade only): speechmatics | openai | valsea
#
#   Preset 1 — VALSEA-first (shown below):     AGENT_ENGINE=cascade  STT_PROVIDER=valsea
#   Preset 2 — Speechmatics cascade:           AGENT_ENGINE=cascade  STT_PROVIDER=speechmatics
#   Preset 3 — OpenAI realtime STT:            AGENT_ENGINE=cascade  STT_PROVIDER=openai
#   Preset 4 — gemini-sts:                     AGENT_ENGINE=gemini-sts
# For cascade, omitted/blank STT_PROVIDER defaults to VALSEA and unknown values
# fail startup. gemini-sts does not use STT_PROVIDER and ignores stale values.
AGENT_ENGINE=cascade
STT_PROVIDER=valsea

# --- Provider credentials (set the ones your chosen preset needs) ----------------
VALSEA_API_KEY=           # Required for AGENT_ENGINE=cascade STT_PROVIDER=valsea
# Optional VALSEA overrides; defaults match the public realtime documentation.
# VALSEA_WS_URL=wss://api.valsea.ai/v1/realtime
# VALSEA_MODEL=valsea-rtt
OPENAI_API_KEY=           # Required for STT_PROVIDER=openai; optional direct cascade LLM/fallback
SPEECHMATICS_API_KEY=     # Optional for speechmatics; blank uses the LiveKit inference gateway
CARTESIA_API_KEY=         # Optional; blank uses the configured TTS gateway unless Google TTS is set

# Google Cloud TTS (Chirp3-HD) — preferred vi TTS when set. Needs a GCP SERVICE
# ACCOUNT (the Gemini key does NOT work for Cloud TTS). Provide ONE:
GOOGLE_TTS_CREDENTIALS_JSON=   # compact one-line service-account JSON (rides --env-file)
GOOGLE_TTS_CREDENTIALS_FILE=/secrets/gtts.json  # mount file vao container; KHONG nhet JSON vao --env-file
#   (private key co \n, docker --env-file se hong: docker run -v /opt/alove-agent/gtts.json:/secrets/gtts.json:ro)
# GOOGLE_TTS_VOICE=Kore

# Gemini Live — required when AGENT_ENGINE=gemini-sts
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Puck

# --- Optional provider/latency overrides ----------------------------------------
# LLM_PROVIDER=openai/gpt-4.1-mini
# TTS_PROVIDER=cartesia/sonic-3
# CASCADE_TURN_DETECTOR=rules            # rules (default, deterministic vi) | off
# CASCADE_MIN_ENDPOINTING_DELAY=0.8
# CASCADE_MAX_ENDPOINTING_DELAY=5.0
# CASCADE_PREEMPTIVE=on
