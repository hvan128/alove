# VéĐi bus-ticket agent worker — copy to agent/.env and fill in.
# NEVER commit the filled .env. Secrets belong in the host secret manager.

# --- LiveKit (same project as the web app) --------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Dispatch name — MUST equal LIVEKIT_AGENT_NAME on the web side (default "vedi").
# For LOCAL dev the worker auto-suffixes "-dev" so it can't steal prod dispatches.
LIVEKIT_AGENT_NAME=vedi

# --- Seam back to Next.js booking core ------------------------------------------
# Where the deployed web app lives (the agent POSTs /api/booking/advance to it).
NEXTJS_API_URL=http://localhost:3000
# Shared secret guarding /api/booking/advance. Generate: openssl rand -hex 32
# Set the SAME value as AGENT_WEBHOOK_SECRET in the web app's env.
AGENT_WEBHOOK_SECRET=

# --- Engine selection (A/B testable) --------------------------------------------
# AGENT_ENGINE: cascade (STT->LLM->TTS) | gemini-sts (Gemini Live speech-to-speech)
# STT_PROVIDER (cascade only): valsea | speechmatics | openai
#
#   Preset 1 — VALSEA-first (brief default):  AGENT_ENGINE=cascade  STT_PROVIDER=valsea
#   Preset 2 — cascade (project-4 parity):    AGENT_ENGINE=cascade  STT_PROVIDER=speechmatics
#   Preset 3 — gemini-sts:                    AGENT_ENGINE=gemini-sts
AGENT_ENGINE=cascade
STT_PROVIDER=speechmatics

# --- Provider credentials (set the ones your chosen preset needs) ----------------
VALSEA_API_KEY=
OPENAI_API_KEY=
SPEECHMATICS_API_KEY=
CARTESIA_API_KEY=

# Google Cloud TTS (Chirp3-HD) — preferred vi TTS when set. Needs a GCP SERVICE
# ACCOUNT (the Gemini key does NOT work for Cloud TTS). Provide ONE:
GOOGLE_TTS_CREDENTIALS_JSON=   # compact one-line service-account JSON (rides --env-file)
# GOOGLE_TTS_CREDENTIALS_FILE= # OR a path to the JSON file (local dev)
# GOOGLE_TTS_VOICE=Kore

# Gemini Live — required only when AGENT_ENGINE=gemini-sts
GEMINI_API_KEY=
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_LIVE_VOICE=Puck

# --- Optional provider/latency overrides ----------------------------------------
# LLM_PROVIDER=openai/gpt-4.1-mini
# TTS_PROVIDER=cartesia/sonic-3
# CASCADE_TURN_DETECTOR=rules            # rules (default, deterministic vi) | off
# CASCADE_MIN_ENDPOINTING_DELAY=0.8
# CASCADE_MAX_ENDPOINTING_DELAY=5.0
# CASCADE_PREEMPTIVE=on
