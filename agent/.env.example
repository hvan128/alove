# LiveKit project credentials. The web app must use the same project.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Mandatory speech-to-text and default text-to-speech provider.
VALSEA_API_KEY=
VALSEA_TTS_VOICE=valsea-neutral

# Required only for generative Auto replies. Human mode and approved speech do not need it.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Production dispatch name. Local dev automatically registers with a -dev suffix.
LIVEKIT_AGENT_NAME=vedi-booking-agent
LOG_LEVEL=INFO
