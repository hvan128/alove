{
  "name": "ordervoice",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @ordervoice/web dev",
    "dev:api": "pnpm --filter @ordervoice/api dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm --filter @ordervoice/contracts --filter @ordervoice/core --filter @ordervoice/providers --filter @ordervoice/api --filter @ordervoice/web --filter @ordervoice/db -r test",
    "test:watch": "pnpm --filter @ordervoice/web test -- --watch",
    "test:e2e": "playwright test",
    "build": "pnpm --filter @ordervoice/web build && pnpm --filter @ordervoice/api build",
    "deploy:web": "pnpm --filter @ordervoice/web exec vercel --prod"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.10",
    "jsdom": "^27.2.0",
    "playwright": "^1.58.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "postcss": "8.5.19"
    }
  }
}
