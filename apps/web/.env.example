# Alove web/API environment. Provider credentials belong in agent/.env.

# Neon is required for inventory, booking, call audit, dashboard and readiness.
DATABASE_URL=

# Server-only LiveKit credentials. LIVEKIT_URL is safe to return from the token
# response, but it is intentionally not a NEXT_PUBLIC feature switch.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alove

# Shared bearer secret used only by the Python agent when calling booking/audit APIs.
# Minimum 32 bytes; generate one with: openssl rand -hex 32
AGENT_WEBHOOK_SECRET=

# Public ticket verification. Required, server-only HMAC key used to derive
# distributed rate-limit bucket IDs without storing raw IP/code/phone values.
# Minimum 32 bytes; use a different value from AGENT_WEBHOOK_SECRET.
BOOKING_VERIFICATION_SECRET=

# Optional operator integration. Leave all three blank to disable delivery.
# Production URL must be HTTPS on port 443 and its exact hostname must appear in
# the comma-separated allowlist. The signing secret must be at least 32 bytes.
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=
BOOKING_WEBHOOK_ALLOWED_HOSTS=
# Vercel Cron sends this value as `Authorization: Bearer ...` to the durable
# outbox recovery. Required on the deployed project (minimum 32 bytes), including
# while booking webhook delivery is explicitly disabled.
CRON_SECRET=

# Pilot dashboard gate. Minimum 32 characters; unset means dashboard is closed.
DASHBOARD_ACCESS_KEY=
