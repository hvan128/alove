# Alove web/API environment. Provider credentials belong in agent/.env.

# Neon is required for inventory, booking, call audit, dashboard and readiness.
DATABASE_URL=

# Server-only LiveKit credentials. LIVEKIT_URL is safe to return from the token
# response, but it is intentionally not a NEXT_PUBLIC feature switch.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=alove

# Shared bearer secret used only by the Python agent when calling booking/audit APIs.
# Minimum 32 bytes; generate one with: openssl rand -hex 32
AGENT_WEBHOOK_SECRET=

# Pilot dashboard gate. Minimum 32 characters; unset means dashboard is closed.
DASHBOARD_ACCESS_KEY=
