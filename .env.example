# Alove — mẫu biến môi trường. Copy sang .env rồi điền giá trị thật.
# File này .gitignore bỏ qua (.env*) và chưa từng bị commit. TUYỆT ĐỐI không commit.
# Nguồn: env worker trên hermes-vm + Vercel production, gộp lại ngày 2026-07-18.

# --- LiveKit (cuộc gọi thoại) -------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Có giá trị = /console dùng transport LiveKit. Bỏ trống = demo in-browser.
NEXT_PUBLIC_LIVEKIT_URL=
# Phải khớp giữa web và agent worker.
LIVEKIT_AGENT_NAME=vedi

# --- Seam agent -> Next.js ----------------------------------------------------
AGENT_WEBHOOK_SECRET=
# Chạy local thì agent gọi vào máy mình; production trỏ về https://vedi-one.vercel.app
NEXTJS_API_URL=http://localhost:3000

# --- Database (Neon, database `vedi`) -----------------------------------------
DATABASE_URL=
DASHBOARD_ACCESS_KEY=

# --- STT ----------------------------------------------------------------------
VALSEA_API_KEY=
SPEECHMATICS_API_KEY=

# --- LLM ----------------------------------------------------------------------
OPENAI_API_KEY=
# Đo trên worker Singapore: gpt-4.1 trung vị 0.74s, deepseek-v4-flash 1.59s.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- TTS ----------------------------------------------------------------------
# Google Chirp3-HD là giọng đang dùng. Service account nằm ở file bên dưới.
GOOGLE_TTS_CREDENTIALS_FILE=./agent/google-tts-credentials.json
GOOGLE_TTS_VOICE=Kore
CARTESIA_API_KEY=
# Không còn dùng: đã gỡ ElevenLabs khỏi hệ thống. Giữ key phòng khi quay lại.
ELEVENLABS_API_KEY=
MINIMAX_API_KEY=

# --- Cấu hình agent (không phải secret) ---------------------------------------
AGENT_ENGINE=cascade
STT_PROVIDER=valsea
LLM_PROVIDER=openai/gpt-4.1
CASCADE_MIN_ENDPOINTING_DELAY=0.5

# --- Pilot điện thoại (chưa dùng) ---------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=
