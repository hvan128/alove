# VéĐi local two-tab demo needs no environment variables.
# Web/Vercel values below must stay server-side.
DATABASE_URL=

# Local-only operator actor. Never enable on production deployment.
# OPERATOR_DEMO_ROLE picks which role the demo actor holds so all four
# operations roles can be exercised: admin, dispatcher, customer-care, read-only.
OPERATOR_DEMO_MODE=false
OPERATOR_DEMO_ROLE=admin

# Production identity seam. The upstream IdP/gateway sets x-operator-id and
# x-operator-role; a browser must never be able to set them. When the directory
# below is configured it outranks the header role, so a stale or forged header
# cannot escalate an identity. Format: id:role,id:role
OPERATOR_STAFF_DIRECTORY=

# LiveKit room/token/agent pilot. Only the URL may be exposed to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vedi-booking-agent
VOICE_AGENT_ENABLED=false
VALSEA_ENABLED=false

# Optional telephone pilot.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=

# VALSEA_API_KEY and OPENAI_API_KEY belong in agent/.env, not the web app.
