# Alove Web Call demo for nhà xe Mai Anh needs no environment variables.
# All values below are optional pilot integrations and must stay server-side.
# Neon Postgres — bật lưu call/transcript/booking cho dashboard. Migration:
# cd apps/web && pnpm exec drizzle-kit migrate
DATABASE_URL=
# Khóa vào /dashboard (giám sát cuộc gọi). Tối thiểu 8 ký tự; thiếu → dashboard đóng.
DASHBOARD_ACCESS_KEY=
VALSEA_API_KEY=
OPENAI_API_KEY=

# LiveKit room/token/agent. Only the URL may be exposed to the browser.
# Setting NEXT_PUBLIC_LIVEKIT_URL switches /console (Agent tự động) from the
# in-browser Web Speech demo to a real LiveKit call served by the agent worker.
# Leave it blank to keep the zero-key in-browser demo as the transport.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=
# Dispatch name; must equal LIVEKIT_AGENT_NAME in agent/.env.
LIVEKIT_AGENT_NAME=alove
# Shared secret guarding POST /api/booking/advance (the agent's only write path
# into the deterministic booking core). Generate: openssl rand -hex 32
AGENT_WEBHOOK_SECRET=

# PSTN qua LiveKit SIP không cần env riêng ở web app — cấu hình bằng `lk` CLI,
# xem docs/pstn-sip-runbook.md và scripts/sip/*.example.json.

# Optional telephone pilot (legacy Twilio Media Streams seam).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=

# Provider defaults remain explicit. Device TTS powers the zero-key demo.
ASR_PROVIDER=valsea
TTS_PROVIDER=device
