# VéĐi local two-tab demo needs no environment variables.
# Web/Vercel values below must stay server-side.
DATABASE_URL=

# Local-only operator admin actor. Never enable on production deployment.
OPERATOR_DEMO_MODE=false

# F-13 live operator catalog sync. Fails closed: sync stays disabled unless a
# contract id is set AND its reconciliation run has passed. Setting these does not
# implement sync — it only unblocks an adapter that already passed reconciliation.
CATALOG_LIVE_SYNC_CONTRACT_ID=
CATALOG_LIVE_SYNC_RECONCILIATION_PASSED=false
CATALOG_LIVE_SYNC_RECONCILED_AT=

# LiveKit room/token/agent pilot. Only the URL may be exposed to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=vedi-booking-agent
VOICE_AGENT_ENABLED=false
VALSEA_ENABLED=false

# Optional telephone pilot.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=

# VALSEA_API_KEY and OPENAI_API_KEY belong in agent/.env, not the web app.
