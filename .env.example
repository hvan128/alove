# VéĐi Web Call demo needs no environment variables.
# All values below are optional pilot integrations and must stay server-side.
DATABASE_URL=
VALSEA_API_KEY=
OPENAI_API_KEY=

# LiveKit room/token/agent pilot. Only the URL may be exposed to the browser.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=

# Optional telephone pilot.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WEBHOOK_BASE_URL=
PUBLIC_GATEWAY_URL=
NEXT_PUBLIC_GATEWAY_URL=

# Provider defaults remain explicit. Device TTS powers the zero-key demo.
ASR_PROVIDER=valsea
TTS_PROVIDER=device
